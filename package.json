{
  "name": "radar-alerts",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "check": "npm test && npm run typecheck && npm run test:runtime",
    "deploy": "wrangler deploy",
    "test:runtime": "wrangler deploy --dry-run --outdir dist && node test/rss-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "miniflare": "5.20261012.0-beta",
    "typescript": "^5.9.3",
    "wrangler": "4.151.0"
  }
}
